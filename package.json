{
  "name": "radon",
  "version": "1.0.0",
  "description": "A hierarchical Radon transform built with WebGPU fragment shaders and WebAssembly",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:wasm": "asc assembly/core.ts --outFile public/core.wasm --optimize --runtime minimal",
    "predev": "npm run build:wasm",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:wasm && node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@webgpu/types": "^0.1.74",
    "assemblyscript": "^0.28.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
